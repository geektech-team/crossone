{
  "name": "crossone-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "tooling/*"
  ],
  "dependencies": {
    "transone": "^0.9.0",
    "@geektech/backone": "^0.1.2"
  },
  "devDependencies": {
    "transone-cli": "0.10.0",
    "typescript": "5.9.3",
    "bun-types": "^1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter @crossone-app/client-web-phone --filter @crossone-app/client-web-pc --filter @crossone-app/client-mini-weixin --filter @crossone-app/client-mini-alipay --filter @crossone-app/client-mini-bytedance --filter @crossone-app/client-mini-xiaohongshu --filter @crossone-app/client-app-ios --filter @crossone-app/client-app-android --filter @crossone-app/client-app-harmony --filter @crossone-app/api dev",
    "dev:client-web-phone": "bun run --cwd apps/client-web-phone dev",
    "build:client-web-phone": "bun run --cwd apps/client-web-phone build",
    "dev:client-web-pc": "bun run --cwd apps/client-web-pc dev",
    "build:client-web-pc": "bun run --cwd apps/client-web-pc build",
    "dev:client-mini-weixin": "bun run --cwd apps/client-mini-weixin dev",
    "build:client-mini-weixin": "bun run --cwd apps/client-mini-weixin build",
    "dev:client-mini-alipay": "bun run --cwd apps/client-mini-alipay dev",
    "build:client-mini-alipay": "bun run --cwd apps/client-mini-alipay build",
    "dev:client-mini-bytedance": "bun run --cwd apps/client-mini-bytedance dev",
    "build:client-mini-bytedance": "bun run --cwd apps/client-mini-bytedance build",
    "dev:client-mini-xiaohongshu": "bun run --cwd apps/client-mini-xiaohongshu dev",
    "build:client-mini-xiaohongshu": "bun run --cwd apps/client-mini-xiaohongshu build",
    "dev:client-app-ios": "bun run --cwd apps/client-app-ios dev",
    "build:client-app-ios": "bun run --cwd apps/client-app-ios build",
    "dev:client-app-android": "bun run --cwd apps/client-app-android dev",
    "build:client-app-android": "bun run --cwd apps/client-app-android build",
    "dev:client-app-harmony": "bun run --cwd apps/client-app-harmony dev",
    "build:client-app-harmony": "bun run --cwd apps/client-app-harmony build",
    "dev:api": "bun run --cwd services/api dev",
    "debug:api": "bun run --cwd services/api debug",
    "build": "bun run build:packages && bun run build:client-web-phone && bun run build:client-web-pc && bun run build:client-mini-weixin && bun run build:client-mini-alipay && bun run build:client-mini-bytedance && bun run build:client-mini-xiaohongshu && bun run build:client-app-ios && bun run build:client-app-android && bun run build:client-app-harmony && bun run build:api",
    "build:packages": "bun run --filter @crossone-app/config --filter @crossone-app/contracts --filter @crossone-app/modules --filter @crossone-app/ui build",
    "build:api": "bun run --cwd services/api build",
    "start:api": "bun run --cwd services/api start",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun test"
  }
}
