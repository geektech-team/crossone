{
  "name": "@crossone-app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@geektech/backone": "^0.4.0",
    "@crossone-app/config": "workspace:*",
    "@crossone-app/contracts": "workspace:*",
    "@crossone-app/modules": "workspace:*"
  },
  "devDependencies": {
    "@geektech/backone-cli": "0.5.0",
    "typescript": "5.9.3",
    "bun-types": "^1.3.0"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun test --pass-with-no-tests",
    "dev": "bun --watch src/index.ts",
    "debug": "bun --inspect --watch src/index.ts",
    "build": "bun build ./src/index.ts --target bun --outdir dist",
    "start": "NODE_ENV=production bun dist/index.js",
    "backone:help": "backone --help"
  }
}
